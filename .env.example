# Server Configuration
APP_PORT=3000

# Database Configuration (MySQL)
Host=localhost
DB_PORT=3306
User=root
Password=
DbName=your_database_name

# JWT Authentication
secret=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Brevo SMTP Configuration
SMTP_Server=smtp-relay.brevo.com
Port=587
Login=your_brevo_smtp_login
SMTP_key=your_brevo_smtp_key
# IMPORTANT: SMTP_FROM must be a verified sender in your Brevo account (e.g. your account email)
SMTP_FROM=your_verified_brevo_email@domain.com
